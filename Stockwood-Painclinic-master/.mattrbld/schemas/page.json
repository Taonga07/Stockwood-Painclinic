{
  "fields": [
    {
      "type": "text",
      "key": "title",
      "label": "Page Title",
      "validation": {
        "enforceMinMax": true,
        "max": null,
        "min": null,
        "regex": null,
        "regexError": null,
        "required": true,
        "unit": "length"
      }
    },
    {
      "type": "text",
      "key": "eyebrow",
      "label": "Eyebrow",
      "description": "Small label above the heading. Leave empty to use the parent section name."
    },
    {
      "type": "text",
      "key": "description",
      "label": "Meta Description",
      "description": "Optional. Falls back to the site description."
    },
    {
      "type": "toggle",
      "key": "hide_sidebar",
      "label": "Hide sidebar",
      "default": false,
      "description": "Hide the 'get in touch' sidebar."
    },
    {
      "type": "group",
      "key": "lead_image",
      "label": "Lead image",
      "value": [
        {
          "type": "image",
          "key": "src",
          "label": "Image",
          "options": {
            "resolutionHint": "",
            "removable": true,
            "simple": true
          }
        },
        {
          "type": "text",
          "key": "alt",
          "label": "Alt text",
          "description": "Describe the image for screen readers."
        }
      ]
    },
    {
      "type": "rich text",
      "key": "content",
      "label": "Page Content",
      "options": {
        "outputFormat": "markdown",
        "blockFormats": [
          "blockquote",
          "heading",
          "hr",
          "orderedList",
          "unorderedList"
        ],
        "inlineFormats": [
          "em",
          "strong",
          "link"
        ],
        "minHeading": 2,
        "maxHeading": 4,
        "allowRaw": false,
        "linkOptions": [
          "allowExternal",
          "allowInternal"
        ]
      }
    }
  ]
}
