{
  "fields": [
    {
      "type": "text",
      "key": "title",
      "label": "Page Title",
      "validation": {
        "enforceMinMax": true,
        "max": null,
        "min": null,
        "regex": null,
        "regexError": null,
        "required": true,
        "unit": "length"
      }
    },
    {
      "type": "text",
      "key": "eyebrow",
      "label": "Eyebrow",
      "description": "Small label above the heading. Leave empty to use the parent section name."
    },
    {
      "type": "text",
      "key": "description",
      "label": "Meta Description",
      "description": "Optional. Falls back to the site description."
    },
    {
      "type": "toggle",
      "key": "hide_sidebar",
      "label": "Hide sidebar",
      "default": false,
      "description": "Hide the 'get in touch' sidebar."
    },
    {
      "type": "toggle",
      "key": "show_price_table",
      "label": "Show price table",
      "default": false,
      "description": "Shows the plans from Contact, hours, prices & reviews → Pricing."
    },
    {
      "type": "toggle",
      "key": "show_booking",
      "label": "Show online booking widget",
      "default": false,
      "description": "Shown below the page text."
    },
    {
      "type": "rich text",
      "key": "content",
      "label": "Page Content",
      "options": {
        "outputFormat": "markdown",
        "blockFormats": [
          "blockquote",
          "heading",
          "hr",
          "orderedList",
          "unorderedList"
        ],
        "inlineFormats": [
          "em",
          "strong",
          "link"
        ],
        "minHeading": 2,
        "maxHeading": 4,
        "allowRaw": false,
        "linkOptions": [
          "allowExternal",
          "allowInternal"
        ]
      }
    }
  ]
}
